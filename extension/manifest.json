{
  "manifest_version": 3,
  "name": "Lead Chai — Maps Lead Finder",
  "version": "1.0.0",
  "description": "Find Google Maps business leads and enrich emails with the Lead Chai API.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lead Chai",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "downloads", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://maps.google.com/*",
    "https://www.google.com.bd/*",
    "https://www.google.co.uk/*",
    "https://www.google.co.in/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*",
    "https://www.google.de/*",
    "https://www.google.fr/*",
    "https://www.google.co.jp/*",
    "https://www.google.com.br/*",
    "https://www.google.com.pk/*",
    "https://www.google.ae/*",
    "https://www.google.com.sa/*",
    "https://www.google.com.sg/*",
    "https://www.google.com.my/*",
    "https://www.google.co.id/*",
    "https://www.google.com.np/*",
    "https://www.google.lk/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*",
        "https://www.google.com.bd/maps*",
        "https://www.google.co.uk/maps*",
        "https://www.google.co.in/maps*",
        "https://www.google.ca/maps*",
        "https://www.google.com.au/maps*",
        "https://www.google.de/maps*",
        "https://www.google.fr/maps*",
        "https://www.google.co.jp/maps*",
        "https://www.google.com.br/maps*",
        "https://www.google.com.pk/maps*",
        "https://www.google.ae/maps*",
        "https://www.google.com.sa/maps*",
        "https://www.google.com.sg/maps*",
        "https://www.google.com.my/maps*",
        "https://www.google.co.id/maps*",
        "https://www.google.com.np/maps*",
        "https://www.google.lk/maps*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css", "icons/*"],
      "matches": ["https://*/*"]
    }
  ]
}
